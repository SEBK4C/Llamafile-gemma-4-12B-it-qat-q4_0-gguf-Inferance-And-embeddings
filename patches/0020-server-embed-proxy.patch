 #include <functional>
@@ -456,6 +457,32 @@ bool server_http_context::start() {
             srv->Post("/tts/(.*)", mkfwd(vport, 4));
         }
     }
+
+    // Baked-in embeddings (v0.6.0): spawn the bundled embedding sidecar (this
+    // same APE re-exec'd with the baked embed model) and reverse-proxy it at
+    // /embed/* — /embed/v1/embeddings, /embed/health, /embed/tokenize. Longer
+    // read timeout than voice: batch embeddings of large chunks take a while
+    // on CPU.
+    {
+        const int eport = llamafile_embed_start();
+        if (eport > 0) {
+            auto efwd = [eport](const httplib::Request & req, httplib::Response & res) {
+                httplib::Client up("127.0.0.1", eport);
+                up.set_connection_timeout(10, 0);
+                up.set_read_timeout(300, 0);
+                std::string path = req.path.substr(6); // strip "/embed"
+                if (path.empty()) path = "/";
+                httplib::Result r = req.method == "POST"
+                    ? up.Post(path, req.body, req.get_header_value("Content-Type").c_str())
+                    : up.Get(path);
+                if (!r) { res.status = 502; res.set_content("{\"error\":\"embedding backend not ready\"}", "application/json"); return; }
+                res.status = r->status;
+                res.set_content(r->body, r->get_header_value("Content-Type").empty() ? "application/json" : r->get_header_value("Content-Type").c_str());
+            };
+            srv->Get("/embed/(.*)", efwd);
+            srv->Post("/embed/(.*)", efwd);
+        }
+    }
 #endif
 
     // run the HTTP server in a thread
