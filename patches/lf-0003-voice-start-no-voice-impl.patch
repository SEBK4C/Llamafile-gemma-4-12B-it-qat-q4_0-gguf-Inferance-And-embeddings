     // Default: keep FLAG_gpu as AUTO (GPU auto-enabled)
 }
+
+// Baked-voice hook for the overlay server (tools/server/server-http.cpp).
+// Returns the TTS backend port when this build spawned one, else <= 0 to
+// skip the /tts reverse proxy. The branch-tip overlay calls this symbol but
+// its implementation (the /zip/tts-server.ape spawner, see the superproject's
+// voice/BAKED-VOICE.md) was never pushed to this fork — so builds link a
+// no-voice implementation. It warns loudly when a voice payload IS baked in,
+// so a payload-carrying package fails visibly rather than silently deaf.
+int llamafile_voice_start(void) {
+    if (!access("/zip/tts-server.ape", F_OK)) {
+        fprintf(stderr,
+                "warning: this llamafile carries a baked voice payload but "
+                "this build has no voice spawner — /tts disabled; run the "
+                "TTS sidecar externally (voice/voice-watchdog.sh)\n");
+    }
+    return 0;
+}
