     // Default: keep FLAG_gpu as AUTO (GPU auto-enabled)
 }
+
+// Baked-voice hook for the overlay server (tools/server/server-http.cpp).
+// Returns the TTS backend port when one is available, else <= 0 to skip the
+// /tts reverse proxy. The branch-tip overlay calls this symbol but its baked
+// spawner (the /zip/tts-server.ape path, see the superproject's
+// voice/BAKED-VOICE.md) was never pushed to this fork. Instead this build
+// supports an EXTERNAL sidecar: set LLAMAFILE_TTS_PORT to the loopback port
+// of a running TTS server speaking POST /v1/audio/speech -> audio/wav
+// (kokoro_server.py or TTS.cpp tts-server) and the web UI's read-aloud
+// controls light up through the built-in /tts proxy. Warns loudly when a
+// voice payload IS baked in, so a payload-carrying package fails visibly
+// rather than silently deaf.
+int llamafile_voice_start(void) {
+    const char *env = getenv("LLAMAFILE_TTS_PORT");
+    if (env && *env) {
+        int port = atoi(env);
+        if (port > 0 && port < 65536) {
+            fprintf(stderr,
+                    "voice: proxying /tts to 127.0.0.1:%d (LLAMAFILE_TTS_PORT)\n",
+                    port);
+            return port;
+        }
+        fprintf(stderr, "warning: ignoring invalid LLAMAFILE_TTS_PORT=%s\n", env);
+    }
+    if (!access("/zip/tts-server.ape", F_OK)) {
+        fprintf(stderr,
+                "warning: this llamafile carries a baked voice payload but "
+                "this build has no voice spawner — /tts disabled; run the "
+                "TTS sidecar externally and set LLAMAFILE_TTS_PORT\n");
+    }
+    return 0;
+}
