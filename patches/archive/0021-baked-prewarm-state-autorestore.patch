+    // automatic slot KV persistence: with --slot-save-path set, the server
+    // restores autosave-slot-<id>.bin at startup and rewrites it on graceful
+    // shutdown, so prompt KV survives restarts without /slots API calls.
+    // Failures only warn: a missing/corrupt/incompatible file or an
+    // unwritable directory degrades to a cold start, never an abort.
+    std::string slot_autosave_filepath(const server_slot & slot) const {
+        return params_base.slot_save_path + "autosave-slot-" + std::to_string(slot.id) + ".bin";
+    }
+
+    void slots_autosave() {
+        for (auto & slot : slots) {
+            if (slot.prompt.n_tokens() == 0) {
+                continue;
+            }
+            if (slot.prompt.tokens.has_media()) {
+                SLT_WRN(slot, "%s", "autosave skipped: media slot states cannot be serialized\n");
+                continue;
+            }
+            const std::string filepath = slot_autosave_filepath(slot);
+            const llama_tokens & tokens = slot.prompt.tokens.get_tokens();
+            const size_t nwrite = llama_state_seq_save_file(ctx_tgt, filepath.c_str(), slot.id, tokens.data(), tokens.size());
+            if (nwrite == 0) {
+                SLT_WRN(slot, "autosave failed for %s (directory unwritable?)\n", filepath.c_str());
+            } else {
+                SLT_INF(slot, "autosaved %zu tokens (%.1f MiB) to %s\n",
+                        tokens.size(), nwrite / (1024.0 * 1024.0), filepath.c_str());
+            }
+        }
+    }
+
+    void slots_autorestore() {
+        for (auto & slot : slots) {
+            const std::string filepath = slot_autosave_filepath(slot);
+            FILE * f = std::fopen(filepath.c_str(), "rb");
+#ifdef COSMOCC
+            if (f == nullptr && !params_base.slot_save_path.empty()) {
+                // Shipped prewarm (Mac Metal profile): the packaged zip may
+                // carry a pre-computed slot state holding the default system
+                // prompt's KV, so the very first message skips its prefill.
+                // Baked per-profile because state files encode the context
+                // geometry (.args.xnu: -c 8192 -np 2 -> 4096/slot); a
+                // mismatched file degrades to a cold start by design.
+                char zpath[64];
+                snprintf(zpath, sizeof(zpath), "/zip/.prewarm-xnu-slot-%d.bin", slot.id);
+                if (IsXnu() && !access(zpath, F_OK) &&
+                    llamafile_extract(zpath, filepath.c_str())) {
+                    SLT_INF(slot, "extracted baked prewarm state %s\n", zpath);
+                    f = std::fopen(filepath.c_str(), "rb");
+                }
+            }
+#endif
+            if (f == nullptr) {
+                continue;
+            }
+            std::fclose(f);
+            llama_tokens tokens;
+            tokens.resize(slot.n_ctx);
+            size_t token_count = 0;
+            const size_t nread = llama_state_seq_load_file(ctx_tgt, filepath.c_str(), slot.id, tokens.data(), tokens.size(), &token_count);
+            if (nread == 0) {
+                slot.prompt.tokens.clear();
+                SLT_WRN(slot, "autorestore failed for %s (stale or incompatible state file, starting cold)\n", filepath.c_str());
+                continue;
+            }
+            tokens.resize(token_count);
+            slot.prompt.tokens.clear();
+            slot.prompt.tokens.insert(tokens);
+            SLT_INF(slot, "autorestored %zu tokens from %s\n", token_count, filepath.c_str());
+        }
+    }
